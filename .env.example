# Decodo ISP proxy credentials (decodo.com, ports 10011–10096)
DECODO_USERNAME=your_username
DECODO_PASSWORD=your_password

# Browser viewport size (default 7680x4320 = 8K)
VIEWPORT_WIDTH=7680
VIEWPORT_HEIGHT=4320

# Default zoom level for regions without an explicit zoom
ZOOM_LEVEL=13

# Global tile capture grid (hard cutover from region captures)
GLOBAL_GRID_BBOX=-60,-180,75,180
GLOBAL_GRID_DEFAULT_ZOOM=9
GLOBAL_TILE_BATCH_SIZE=12
TILE_ACCEPT_BUFFER_PX=8
RESPECT_TILE_SCHEDULE=1

# Parallelism: concurrent browser workers (each pulls regions from a shared queue)
# Scale up based on available RAM (~150-300MB per browser at 8K viewport)
MAX_BROWSERS=2

# --- Pan / readiness tuning (speed) ------------------------------------------
# Panning between tiles is mouse-drag (the Leaflet map object is not injectable,
# so setView is unavailable). Every intermediate mouse move forces a full ~33MP
# repaint at 8K, so MOUSE_DRAG_STEPS is the dominant pan cost — keep it small.
# Raise it only if a faster drag starts producing coverage gaps between tiles.
MOUSE_DRAG_STEPS=3
# Max single-drag distance (px); 800 keeps each step below Leaflet's inertia
# threshold. Tuning only — do not raise without confirming no overshoot.
MAX_DRAG_PX=800
# Far-jump threshold: above this many mouse-drag steps a viewport move uses a
# fresh URL load (page.goto centered on target) instead of dragging. A
# neighbouring 8K z12 tile is ~10 steps, so 24 allows local hops but avoids the
# 300-500 step drags that made sparse z12 tiles cost thousands of seconds.
URL_NAV_MAX_DRAG_STEPS=24
# Base-map tile readiness wait cap (ms). Early-exits via .leaflet-tile-loaded.
TILES_WAIT_MS=5000
# Vessel-data readiness: waits for get_data_json_4 network responses to go quiet
# (the only reliable "markers loaded" signal — the marker canvas is cross-origin
# tainted). AIS_WAIT_MS caps the wait; AIS_QUIET_MS is the quiescence window;
# AIS_RENDER_SETTLE_MS lets markers paint before the screenshot;
# AIS_FIRST_RESPONSE_GRACE_MS bails out early if no vessel request fires.
AIS_WAIT_MS=3000
AIS_QUIET_MS=400
AIS_RENDER_SETTLE_MS=250
AIS_FIRST_RESPONSE_GRACE_MS=1200

# Set to 1 (or use --save-images flag) to write tile images to disk
SAVE_IMAGES=0
SCREENSHOT_FORMAT=jpeg
SCREENSHOT_QUALITY=85
MARKER_DEDUP_EPS_DEG=0.003

# How often the scraper loops (minutes) and random jitter (seconds)
SCRAPE_INTERVAL_MINUTES=60
JITTER_SECONDS=300

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/oceanscrape

# Mapbox API token (used for map tile rendering)
MAPBOX_TOKEN=your_mapbox_token
