# Decodo ISP proxy credentials (decodo.com, ports 10011–10096)
DECODO_USERNAME=your_username
DECODO_PASSWORD=your_password

# Browser viewport size (default 7680x4320 = 8K)
VIEWPORT_WIDTH=7680
VIEWPORT_HEIGHT=4320

# Default zoom level for regions without an explicit zoom
ZOOM_LEVEL=13

# Parallelism: total concurrent regions = TABS_PER_BROWSER × MAX_BROWSERS
TABS_PER_BROWSER=4
MAX_BROWSERS=4

# Set to 1 (or use --save-images flag) to write tile images to disk
SAVE_IMAGES=0
SCREENSHOT_FORMAT=jpeg
SCREENSHOT_QUALITY=85

# How often the scraper loops (minutes) and random jitter (seconds)
SCRAPE_INTERVAL_MINUTES=60
JITTER_SECONDS=300

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/oceanscrape

# Mapbox API token (used for map tile rendering)
MAPBOX_TOKEN=your_mapbox_token
